rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Para simplificar ahora mismo y que no tengas errores,
    // permitimos lectura y escritura a cualquier usuario que haya hecho login con éxito.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
